{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "Twig",
  "scopeName": "text.html.twig",
  "patterns": [
    { "include": "#twig-tags" },
    { "include": "#html" }
  ],
  "repository": {
    "twig-tags": {
      "patterns": [
        {
          "name": "comment.block.twig",
          "begin": "\\{#",
          "end": "#\\}",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.twig" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.twig" } },
          "patterns": [{ "include": "#twig-expression-content" }]
        },
        {
          "name": "meta.tag.block.twig",
          "begin": "\\{%-?",
          "end": "-?%\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.tag.twig" } },
          "endCaptures": { "0": { "name": "punctuation.section.tag.twig" } },
          "patterns": [{ "include": "#twig-block-content" }]
        },
        {
          "name": "meta.tag.output.twig",
          "begin": "\\{\\{-?",
          "end": "-?\\}\\}",
          "beginCaptures": { "0": { "name": "punctuation.section.tag.twig" } },
          "endCaptures": { "0": { "name": "punctuation.section.tag.twig" } },
          "patterns": [{ "include": "#twig-expression-content" }]
        }
      ]
    },

    "twig-block-content": {
      "patterns": [
        { "include": "#twig-keywords" },
        { "include": "#twig-operators" },
        { "include": "#twig-strings" },
        { "include": "#twig-numbers" },
        { "include": "#twig-constants" },
        { "include": "#twig-functions" },
        { "include": "#twig-variables" }
      ]
    },

    "twig-expression-content": {
      "patterns": [
        { "include": "#twig-strings" },
        { "include": "#twig-numbers" },
        { "include": "#twig-constants" },
        { "include": "#twig-functions" },
        { "include": "#twig-filters" },
        { "include": "#twig-operators" },
        { "include": "#twig-variables" }
      ]
    },

    "twig-keywords": {
      "patterns": [
        {
          "name": "keyword.control.twig",
          "match": "\\b(?:if|elseif|else|endif|for|endfor|block|endblock|extends|include|import|from|macro|endmacro|set|endset|do|apply|endapply|embed|endembed|use|with|endwith|autoescape|endautoescape|verbatim|endverbatim|sandbox|endsandbox|cache|endcache|deprecated|enddeprecated|guard|endguard|types|endtypes|flush)\\b"
        },
        {
          "name": "keyword.control.import.twig",
          "match": "\\b(?:as|import)\\b"
        }
      ]
    },

    "twig-strings": {
      "patterns": [
        {
          "name": "string.quoted.double.twig",
          "begin": "\"",
          "end": "\"",
          "patterns": [
            { "name": "constant.character.escape.twig", "match": "\\\\." },
            { "name": "meta.embedded.line.twig", "match": "#\\{[^}]*\\}" }
          ]
        },
        {
          "name": "string.quoted.single.twig",
          "begin": "'",
          "end": "'",
          "patterns": [{ "name": "constant.character.escape.twig", "match": "\\\\." }]
        }
      ]
    },

    "twig-numbers": {
      "patterns": [
        { "name": "constant.numeric.twig", "match": "\\b\\d[\\d_]*(?:\\.\\d[\\d_]*)?\\b" }
      ]
    },

    "twig-constants": {
      "patterns": [
        { "name": "constant.language.twig", "match": "\\b(?:true|false|null|none)\\b" }
      ]
    },

    "twig-functions": {
      "patterns": [
        {
          "name": "support.function.twig",
          "match": "\\b(?:range|cycle|constant|date|dump|max|min|parent|random|source|attribute|block|template_from_string|path|url|asset|render|is_granted|csrf_token|absolute_url|expression|form|form_start|form_end|form_widget|form_row|form_label|form_errors|form_rest|form_help|controller|fragment_uri|importmap|impersonation_path|impersonation_url|impersonation_exit_path|impersonation_exit_url|logout_path|logout_url|relative_path|country_names|country_timezones|currency_names|language_names|locale_names|script_names|timezone_names|enum|enum_cases|html_attr|html_classes|html_cva|t)\\b"
        }
      ]
    },

    "twig-filters": {
      "patterns": [
        {
          "name": "support.function.twig.filter",
          "match": "\\|\\s*([a-zA-Z_][a-zA-Z0-9_]*)",
          "captures": {
            "1": { "name": "entity.name.function.twig" }
          }
        }
      ]
    },

    "twig-operators": {
      "patterns": [
        { "name": "keyword.operator.word.twig", "match": "\\b(?:and|or|not|xor|in|is|same as|divisible by|starts with|ends with|matches|has some|has every|b-and|b-or|b-xor)\\b" },
        { "name": "keyword.operator.symbol.twig", "match": "(?:\\|\\||&&|==|!=|<=>|<=|>=|===|!==|\\.\\.|=>|\\?\\?|\\?\\.|\\|(?![\\s\\|])|~)" },
        { "name": "keyword.operator.assignment.twig", "match": "=" }
      ]
    },

    "twig-variables": {
      "patterns": [
        {
          "name": "variable.other.twig",
          "match": "\\b[a-zA-Z_][a-zA-Z0-9_]*\\b"
        }
      ]
    },

    "html": {
      "patterns": [
        { "include": "#html-doctype" },
        { "include": "#html-comment" },
        { "include": "#html-entity" },
        { "include": "#html-tag" }
      ]
    },

    "html-doctype": {
      "patterns": [
        {
          "name": "meta.tag.sgml.doctype.html",
          "begin": "<!(?i:DOCTYPE)",
          "end": ">",
          "beginCaptures": { "0": { "name": "keyword.control.doctype.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.tag.end.html" } },
          "patterns": [
            { "name": "constant.language.doctype.html", "match": "(?i:HTML)" },
            { "name": "string.quoted.double.doctype.html", "match": "\"[^\"]*\"" }
          ]
        }
      ]
    },

    "html-comment": {
      "patterns": [
        {
          "name": "comment.block.html",
          "begin": "<!--",
          "end": "-->",
          "beginCaptures": { "0": { "name": "punctuation.definition.comment.html" } },
          "endCaptures": { "0": { "name": "punctuation.definition.comment.html" } }
        }
      ]
    },

    "html-entity": {
      "patterns": [
        {
          "name": "constant.character.entity.html",
          "match": "&(?:[a-zA-Z0-9]+|#\\d+|#x[0-9a-fA-F]+);"
        }
      ]
    },

    "html-tag": {
      "patterns": [
        {
          "name": "meta.tag.sgml.end.html",
          "match": "</(\\w[\\w-]*)>",
          "captures": {
            "0": { "name": "punctuation.definition.tag.end.html" },
            "1": { "name": "entity.name.tag.html" }
          }
        },
        {
          "name": "meta.tag.void.html",
          "begin": "<(\\w[\\w-]*)(?=[\\s/>])",
          "end": "/?>",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.begin.html" },
            "1": { "name": "entity.name.tag.html" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#html-tag-attributes" }
          ],
          "applyEndPatternLast": 1
        },
        {
          "name": "meta.tag.block.html",
          "begin": "<(\\w[\\w-]*)",
          "end": ">",
          "beginCaptures": {
            "0": { "name": "punctuation.definition.tag.begin.html" },
            "1": { "name": "entity.name.tag.html" }
          },
          "endCaptures": {
            "0": { "name": "punctuation.definition.tag.end.html" }
          },
          "patterns": [
            { "include": "#html-tag-attributes" }
          ]
        }
      ]
    },

    "html-tag-attributes": {
      "patterns": [
        {
          "name": "entity.other.attribute-name.html",
          "match": "\\b([a-zA-Z][a-zA-Z0-9_:-]*)\\b(?=\\s*(?:=|\\s|/>|>))",
          "captures": {
            "1": { "name": "entity.other.attribute-name.html" }
          }
        },
        {
          "name": "string.quoted.double.html",
          "begin": "=\"",
          "end": "\"",
          "beginCaptures": { "0": { "name": "punctuation.separator.key-value.html" } },
          "patterns": [
            { "include": "#twig-tags" },
            { "include": "#html-entity" }
          ]
        },
        {
          "name": "string.quoted.single.html",
          "begin": "='",
          "end": "'",
          "beginCaptures": { "0": { "name": "punctuation.separator.key-value.html" } },
          "patterns": [
            { "include": "#twig-tags" },
            { "include": "#html-entity" }
          ]
        },
        {
          "name": "string.unquoted.html",
          "match": "\\b[a-zA-Z][a-zA-Z0-9_.-]*\\b"
        }
      ]
    }
  }
}
